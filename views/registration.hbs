<span class="reglog">Регистрация</span>

<form action="/api/reg" method="post">
    <input type="text" name="regname" class="regname" placeholder="Ваше имя. Пример: Андрей">
    <input type="text" name="username" class="username" placeholder="Имя пользователя. Пример: @andrew">
    <input type="email" name="email" class="email" placeholder="Почта. Пример: andrew@.сom">
    <button type="button" class="eye-button">Глазик</button>
    <input type="password" name="password" class="password" placeholder="Пароль от аккаунта">
    <button type="submit" class="registration">Зарегистрироваться</button>
</form>

<span class="href">Если у Вас уже есть аккаунт, можете <a href="/log">выполнить вход</a>.</span>
